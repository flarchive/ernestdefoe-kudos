{
    "name": "ernestdefoe/kudos",
    "description": "Kudos Wall: members thank each other with a few kudos cards a week. A wall of this week's thanks, a weekly spotlight for the most-thanked member, a Kudos tab on profiles, alerts and email.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "kudos",
        "thanks",
        "recognition",
        "appreciation",
        "community"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/kudos",
    "support": {
        "issues": "https://github.com/ernestdefoe/kudos/issues",
        "source": "https://github.com/ernestdefoe/kudos"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Kudos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Kudos\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Kudos Wall",
            "category": "feature",
            "icon": {
                "name": "fas fa-hand-holding-heart",
                "backgroundColor": "#e8590c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "fof/badges"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
